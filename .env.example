# ============================================================
# MediCart — environment configuration
# Copy to .env (`make setup` does this) and edit as needed.
# .env is gitignored. NEVER commit real credentials.
# ============================================================

# ---------- Core ----------
APP_ENV=development                 # development | production
API_PORT=8080
# Comma-separated exact origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info                      # debug | info | warn | error

# ---------- Database ----------
# Host port 55432 is used because this machine already has Postgres on 5432.
DATABASE_URL=postgres://medicart:medicart_dev_pw@localhost:55432/medicart?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ---------- Sessions / auth ----------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
# This development value is a placeholder and is REJECTED when APP_ENV=production.
SESSION_SECRET=dev-only-insecure-secret-change-me-0000000000000000
SESSION_TTL_HOURS=720
# Cookie flags. In production these are forced to secure+none-less strictness.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# First admin is created by `make seed-admin` using these, then they should be
# removed from .env. There are NO hard-coded admin credentials anywhere.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- Object storage ----------
# local  = files on disk under STORAGE_LOCAL_DIR (development default)
# s3     = any S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.localstorage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prescriptions are ALWAYS private and served only via short-lived signed URLs.
PRESCRIPTION_URL_TTL_MINUTES=10
MAX_UPLOAD_BYTES=10485760

# ---------- WhatsApp ----------
# link  = generate wa.me deep links only (no credentials needed, default)
# cloud = WhatsApp Business Cloud API for outbound business-initiated messages
WHATSAPP_DRIVER=link
WHATSAPP_BUSINESS_NUMBER=919999999999      # E.164 without '+', pharmacy's number
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Payments ----------
# mock     = local simulator, clearly labelled, no real money (default)
# razorpay = live adapter; use rzp_test_* keys for sandbox
PAYMENT_DRIVER=mock
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:5173

# ---------- AI assistant ----------
# mock      = deterministic local provider, no API key, no network (default)
# anthropic = Claude API
AI_DRIVER=mock
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_HOUR=40
AI_MAX_TOOL_ITERATIONS=5

# ---------- Feature flags ----------
# Prescription-only medicines cannot be ordered while this is false.
# Do NOT enable until the regulatory checklist in docs/REGULATORY_CHECKLIST.md
# is signed off by a qualified professional.
FEATURE_RX_SALES_ENABLED=false
# Shows the "demonstration data" banner across the storefront.
FEATURE_DEMO_DATA_BANNER=true

# ---------- Commerce defaults (configurable, not hard-coded policy) ----------
DELIVERY_FEE_PAISE=4900
FREE_DELIVERY_THRESHOLD_PAISE=49900
MAX_QTY_PER_ITEM=10
CART_RESERVATION_MINUTES=30

# ---------- Frontend (Vite; only VITE_* reaches the browser) ----------
VITE_API_BASE_URL=http://localhost:8080
